# Copiado para orchestration/.env pelo `make airflow-up` na primeira vez, com os valores gerados.
# O .env fica fora do git.

# UID do seu usuário (id -u): arquivos que o Airflow grava em data_sim/ ficam seus.
AIRFLOW_UID=1000
# Porta da interface, só em 127.0.0.1.
AIRFLOW_PORTA=8080
# Senha do Postgres do Airflow (não é o do serving; não sai da rede do compose).
AIRFLOW_PG_SENHA=troque-aqui
# Segredo dos tokens entre os componentes do Airflow 3.
AIRFLOW_JWT_SECRET=troque-aqui
# Chave Fernet (base64 de 32 bytes) que cifra conexões e variáveis guardadas no banco.
AIRFLOW_FERNET_KEY=troque-aqui

# Alerta de falha da DAG por e-mail (brasileirao.alerta). Com qualquer uma das quatro primeiras
# vazia, o alerta fica desligado e a falha só aparece no log da tarefa. No Gmail, a senha é uma
# senha de app (Conta Google → Segurança → Senhas de app), não a senha da conta.
ALERTA_SMTP_HOST=smtp.gmail.com
ALERTA_SMTP_USUARIO=voce@gmail.com
ALERTA_SMTP_SENHA=
ALERTA_EMAIL_PARA=voce@gmail.com
# 587 com STARTTLS (padrão) ou 465 com SSL.
ALERTA_SMTP_PORTA=587
# Remetente; vazio, vai o próprio usuário.
ALERTA_EMAIL_DE=
