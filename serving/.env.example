# Copie para .env na raiz do projeto (fora do git) e troque os valores.
# Senhas sem espaço, `$` ou `#`: o Makefile e o compose leem este arquivo.

# Superusuário do Postgres do compose
POSTGRES_PASSWORD=troque-aqui

# Senhas dos papéis, definidas pelo initdb/03-senhas.sh na primeira subida
PG_SENHA_CARGA=troque-aqui
PG_SENHA_LEITOR=troque-aqui
PG_SENHA_METABASE=troque-aqui

# Destino da `make carga` (papel carga; localmente, a mesma senha de PG_SENHA_CARGA)
BRASILEIRAO_PG_HOST=localhost
BRASILEIRAO_PG_PORT=5432
BRASILEIRAO_PG_DB=brasileirao
BRASILEIRAO_PG_USUARIO=carga
BRASILEIRAO_PG_SENHA=troque-aqui

# Testes marcados `postgres`: superusuário do Postgres do compose local (a fixture cria um
# banco descartável). Sem esta variável, esses testes são pulados.
BRASILEIRAO_PG_TESTE_URL=postgresql://postgres:troque-aqui@localhost:5432/postgres

# --- VM (Oracle) ---
# Só no .env local: destino de `make carga-remota`, `make deploy` e `make backup-metabase`.
VM_HOST=troque-pelo-ip-ou-dominio-da-vm
VM_USUARIO=ubuntu
# A PG_SENHA_CARGA do .env da VM. A `make carga-remota` usa esta no lugar de
# BRASILEIRAO_PG_SENHA, então a senha local e a da VM podem ser diferentes.
VM_PG_SENHA_CARGA=troque-aqui

# Só no .env da VM: o Caddy pede o certificado pra este nome. Localmente, fica vazio.
DOMINIO=
